<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control
    namespace="YourCompany"
    constructor="OrgChartControl"
    version="1.0.54"
    display-name-key="OrgChartControl_Display_Key"
    description-key="OrgChartControl_Desc_Key"
    control-type="standard">
    <data-set
      name="sampleDataSet"
      display-name-key="Dataset_Display_Key">
    </data-set>

    <data-set
      name="positionsDataSet"
      display-name-key="Positions_Display_Key">
      <property-set
        name="PositionGuid"
        display-name-key="Position_Guid_Key"
        of-type="SingleLine.Text"
        usage="bound"
        required="false" />
      <property-set
        name="PosTeamId"
        display-name-key="Position_Team_Key"
        of-type="SingleLine.Text"
        usage="bound"
        required="false" />
    </data-set>

    <!-- Employees: name + position lookup (as flat text GUID) -->
    <data-set
      name="employeesDataSet"
      display-name-key="Employees_Display_Key">
      <property-set
        name="EmpName"
        display-name-key="Employee_Name_Key"
        of-type="SingleLine.Text"
        usage="bound"
        required="false" />
      <property-set
        name="EmpPositionId"
        display-name-key="Employee_Position_Key"
        of-type="SingleLine.Text"
        usage="bound"
        required="false" />
    </data-set>

  <resources>
    <code path="index.ts" order="1" />
<!--    <css path="css/OrgChart.css" order="1" />
-->
  </resources>
  </control>
</manifest>